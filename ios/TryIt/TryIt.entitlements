<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.lafagency.tryit</string>
	</array>
	<!-- Ücretsiz haklar App Attest ile doğrulanmış cihaza veriliyor.
	     Geliştirme derlemeleri de canlı ortamı kullansın; sunucu ikisini de
	     kabul ediyor ama TestFlight ve App Store zaten canlıda. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
</dict>
</plist>
