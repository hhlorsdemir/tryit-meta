    "Beğendiğin kıyafetin linkini ver, TryIt onu senin fotoğrafına giydirsin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعطِ TryIt رابط القطعة التي أعجبتك، وسيُلبسها لصورتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib TryIt den Link zu einem Teil, das dir gefällt, und es zieht es deinem Foto an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give TryIt the link to a piece you like, and it'll dress your photo in it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale a TryIt el enlace de una prenda que te guste y la pondrá en tu foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donne à TryIt le lien d'une pièce que tu aimes, elle habillera ta photo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai a TryIt il link di un capo che ti piace, e lo veste sulla tua foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気になる服のリンクをTryItに渡すと、あなたの写真に着せてくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마음에 드는 옷의 링크를 TryIt에 주면 내 사진에 입혀줘요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef TryIt de link naar een kledingstuk dat je leuk vindt, dan trekt het jouw foto het aan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê ao TryIt o link de uma peça que você gosta, e ele veste sua foto com ela."
          }
        }
      }
    },
    "Beğendiğin ürünün web adresini yapıştır, parçayı gardırobuna alalım." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
