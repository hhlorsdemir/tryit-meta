    "Bu kombindeki parçalar çalışma ekranına alınacak. Ekranda duran kombine mi eklensin, yoksa sıfırdan mı başlansın?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُنقل قطع هذه الإطلالة إلى شاشة العمل. هل تريد إضافتها إلى الإطلالة الموجودة، أم البدء من جديد؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Teile dieses Outfits werden in den Arbeitsbereich geladen. Zum bestehenden Outfit hinzufügen oder neu beginnen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This outfit's pieces will go to the workspace. Add them to the outfit already there, or start fresh?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las prendas de este look se llevarán a la pantalla de trabajo. ¿Añadirlas al look que ya está ahí o empezar de cero?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pièces de ce look vont être placées sur l'écran de travail. Les ajouter au look déjà présent, ou repartir de zéro ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I capi di questo look verranno portati nell'area di lavoro. Aggiungerli al look già presente o ricominciare da capo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコーデのアイテムを作業画面に移します。今ある画面のコーデに追加しますか、それとも最初からやり直しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 코디의 아이템을 작업 화면으로 가져와요. 화면에 있는 코디에 추가할까요, 아니면 처음부터 시작할까요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De stukken van deze outfit gaan naar het werkscherm. Toevoegen aan de outfit die er al staat, of opnieuw beginnen?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As peças deste look vão para a tela de trabalho. Adicionar ao look que já está lá, ou começar do zero?"
          }
        }
      }
    },
