      }
    },
    "Bugün çok yoğunuz. Yarın tekrar dene." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نحن مشغولون جدًا اليوم. حاول مرة أخرى غدًا."
          }
        },
        "de" : {
          "stringUnit" : {
