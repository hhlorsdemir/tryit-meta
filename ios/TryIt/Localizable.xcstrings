        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'achat est en attente d'approbation. Tes crédits seront débloqués une fois approuvé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'acquisto è in attesa di approvazione. I tuoi crediti si sbloccano una volta approvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入は承認待ちです。承認されると回数が使えるようになります。"
