    "Giydirme bu fotoğrafa bakıyor. Ürünü en iyi gösteren kareyi seç." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم عملية الإلباس هذه الصورة. اختر الصورة التي تُظهر المنتج بأفضل شكل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anprobe nutzt dieses Foto. Wähle das Bild, das das Produkt am besten zeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The try-on uses this photo. Pick the frame that shows the product best."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prueba usa esta foto. Elige la imagen que mejor muestre el producto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'essayage utilise cette photo. Choisis l'image qui montre le mieux le produit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prova usa questa foto. Scegli l'inquadratura che mostra meglio il prodotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試着にはこの写真を使います。商品が一番よく見えるカットを選んでください。"
