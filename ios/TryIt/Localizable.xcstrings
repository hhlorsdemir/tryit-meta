    "Satın alma onay bekliyor. Onaylanınca hakların açılır." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عملية الشراء بانتظار الموافقة. سيُفتح رصيدك بعد الموافقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kauf wartet auf Genehmigung. Dein Guthaben wird nach der Genehmigung freigeschaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purchase is pending approval. Your credits unlock once it's approved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compra está pendiente de aprobación. Tus créditos se desbloquean cuando se apruebe."
