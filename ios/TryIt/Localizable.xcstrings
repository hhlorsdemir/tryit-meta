    "Tam boy, karşıdan ve kollar yanda bir kare en iyi sonucu veriyor." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصورة الكاملة من الأمام مع إبقاء الذراعين على الجانبين تعطي أفضل نتيجة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ganzkörperfoto von vorne mit Armen an der Seite liefert das beste Ergebnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A full-body, front-facing photo with arms at your sides gives the best result."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una foto de cuerpo entero, de frente y con los brazos a los lados da el mejor resultado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une photo en pied, de face, bras le long du corps donne le meilleur résultat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una foto a figura intera, di fronte, con le braccia lungo i fianchi dà il risultato migliore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全身が写った正面向きで、腕を体の横に下ろした写真が最も良い結果になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전신이 보이는 정면 사진, 팔은 옆으로 내린 자세가 가장 좋은 결과를 줘요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een foto van je hele lichaam, van voren, met je armen langs je lichaam geeft het beste resultaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma foto de corpo inteiro, de frente e com os braços ao lado dá o melhor resultado."
          }
        }
      }
    },
