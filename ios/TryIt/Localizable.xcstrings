    "Bu mağaza şu an açılamadı. Birazdan tekrar dene." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر فتح هذا المتجر الآن. حاول مرة أخرى بعد قليل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
