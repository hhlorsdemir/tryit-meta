    },
    "Üst, alt ve ayakkabı otomatik ayrılıyor." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم فصل الأعلى والأسفل والحذاء تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oberteil, Unterteil und Schuhe werden automatisch erkannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top, bottom and shoes are being sorted automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte de arriba, la de abajo y los zapatos se identifican automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le haut, le bas et les chaussures sont identifiés automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top, bottom e scarpe vengono riconosciuti automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トップス、ボトムス、シューズを自動で仕分け中です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상의, 하의, 신발을 자동으로 분류하는 중이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top, onder- en schoenen worden automatisch gesorteerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A parte de cima, a de baixo e o sapato estão sendo identificados automaticamente."
          }
        }
      }
    },
    "Üste bir bluz, alta bir etek, ayağa bir ayakkabı. Farklı mağazalardan olsa bile üçünü birlikte gör." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلوزة في الأعلى، تنورة في الأسفل، وحذاء ليكتمل المظهر. شاهد الثلاثة معًا، حتى لو كانت من متاجر مختلفة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oben eine Bluse, unten ein Rock, dazu Schuhe. Sieh alle drei zusammen, auch wenn sie aus verschiedenen Shops stammen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A blouse on top, a skirt on the bottom, shoes to finish. See all three together, even from different stores."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una blusa arriba, una falda abajo, zapatos para terminar. Ve los tres juntos, aunque sean de tiendas distintas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un chemisier en haut, une jupe en bas, des chaussures. Vois les trois ensemble, même si elles viennent de boutiques différentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una camicetta sopra, una gonna sotto, scarpe a completare. Vedi tutti e tre insieme, anche se da negozi diversi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トップスにブラウス、ボトムスにスカート、そしてシューズ。別々のショップからでも、3つをまとめて見られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상의에는 블라우스, 하의에는 스커트, 신발까지. 서로 다른 쇼핑몰의 아이템이어도 세 가지를 함께 볼 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een blouse boven, een rok onder, schoenen erbij. Bekijk alle drie samen, ook als ze uit verschillende winkels komen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma blusa em cima, uma saia embaixo, sapato para fechar. Veja os três juntos, mesmo que sejam de lojas diferentes."
          }
        }
      }
    },
