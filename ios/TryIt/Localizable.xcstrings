    "Üst, alt ve ayakkabı kişinin fotoğrafına giydiriliyor." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم إلباس الأعلى والأسفل والحذاء لصورتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oberteil, Unterteil und Schuhe werden deinem Foto angezogen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The top, bottom and shoes are put on your photo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte de arriba, la de abajo y los zapatos se ponen en tu foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le haut, le bas et les chaussures sont mis sur ta photo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top, bottom e scarpe vengono indossati sulla tua foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トップス、ボトムス、シューズをあなたの写真に着せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상의, 하의, 신발이 내 사진에 입혀져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De top, onder- en schoenen worden op jouw foto aangetrokken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A parte de cima, a de baixo e o sapato são colocados na sua foto."
          }
        }
      }
    },
    "Üst, alt ve ayakkabı kombine ekleniyor." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم إضافة الأعلى والأسفل والحذاء إلى الإطلالة."
          }
        },
        "de" : {
          "stringUnit" : {
