    "TryIt listede yoksa menüyü sona kaydırıp Daha Fazla'dan aç." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا لم يظهر TryIt في القائمة، مرّر إلى النهاية وافتحه من المزيد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls TryIt nicht in der Liste erscheint, scrolle ans Ende und öffne es über Mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If TryIt isn't in the list, scroll to the end and open it from More."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si TryIt no aparece en la lista, desplázate hasta el final y ábrelo desde Más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si TryIt n'apparaît pas dans la liste, fais défiler jusqu'à la fin et ouvre-le depuis Plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se TryIt non è nell'elenco, scorri fino alla fine e aprilo da Altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TryItが一覧にない場合は、最後までスクロールして「その他」から開いてください。"
          }
        },
        "ko" : {
