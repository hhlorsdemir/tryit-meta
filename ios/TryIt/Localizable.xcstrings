        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "착용 이미지는 이 사진을 사용해요. 상품이 가장 잘 보이는 사진을 선택해주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
