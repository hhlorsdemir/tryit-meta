    },
    "%@ eklenecek. Çıkacak parçayı seç, yeni ürün onun yerine geçsin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم إضافة %@. اختر القطعة التي سيحل محلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird hinzugefügt. Wähle das Teil, das ersetzt werden soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will be added. Pick which piece to replace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se añadirá %@. Elige la prenda que quieres reemplazar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ va être ajouté. Choisis la pièce à remplacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verrà aggiunto. Scegli il capo da sostituire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を追加します。入れ替えるアイテムを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@를 추가할게요. 대신할 아이템을 골라주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wordt toegevoegd. Kies welk kledingstuk vervangen wordt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ será adicionado. Escolha a peça que vai sair."
          }
        }
      }
    },
    "%@ neresi anlaşılmadı, %@ olarak eklendi. Yanlışsa parçaya dokunup düzeltebilirsin." : {
      "comment" : "İlki ürün adı, ikincisi yuva adı (Üst, Alt, Ayakkabı)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر تحديد مكان %@، فتمت إضافته كـ %@. اضغط على القطعة لتصحيحها إذا لزم الأمر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konnte nicht erkennen, wohin %@ gehört, wurde daher als %@ hinzugefügt. Tippe auf das Teil, um es zu korrigieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't tell where %@ goes, so it was added as %@. Tap the piece to fix it if that's wrong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo saber dónde va %@, se añadió como %@. Toca la prenda para corregirlo si hace falta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de savoir où va %@, ajouté comme %@. Touche la pièce pour corriger si besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è chiaro dove vada %@, aggiunto come %@. Tocca il capo per correggerlo se serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の位置がわからなかったため、%@ として追加しました。違う場合はアイテムをタップして直せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 위치를 알 수 없어서 %@로 추가했어요. 틀렸다면 아이템을 눌러 수정할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onduidelijk waar %@ hoort, dus toegevoegd als %@. Tik op het kledingstuk om het te corrigeren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não deu para saber onde %@ entra, foi adicionado como %@. Toque na peça para corrigir se estiver errado."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ neresi anlaşılmadı, %2$@ olarak eklendi. Yanlışsa parçaya dokunup düzeltebilirsin."
          }
        }
      }
    },
