    "Ürün sayfasında Paylaş'a bas, TryIt'i seç. Uygulamayı açtığında parça hazır bekler." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على مشاركة في صفحة المنتج، ثم اختر TryIt. ستكون القطعة جاهزة عند فتح التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf der Produktseite auf Teilen und wähle TryIt aus. Das Teil wartet bereits, wenn du die App öffnest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Share on the product page, then choose TryIt. The piece will be waiting when you open the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Compartir en la página del producto y elige TryIt. La prenda te esperará cuando abras la aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur la page produit, touche Partager, puis choisis TryIt. La pièce t'attendra à l'ouverture de l'application."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Condividi sulla pagina prodotto e scegli TryIt. Il capo ti aspetterà quando apri l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "商品ページで共有をタップし、TryItを選んでください。アプリを開くとアイテムが準備できています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상품 페이지에서 공유를 탭하고 TryIt을 선택하세요. 앱을 열면 아이템이 준비되어 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op Delen op de productpagina en kies TryIt. Het stuk staat klaar zodra je de app opent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Compartilhar na página do produto e escolha o TryIt. A peça estará esperando quando você abrir o app."
          }
        }
      }
    },
