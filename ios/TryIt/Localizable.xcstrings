{
  "sourceLanguage" : "tr",
  "strings" : {
    "%@ / ay. İptal edilmezse dönem sonunda otomatik yenilenir. İptal için Ayarlar > Apple Hesabı > Abonelikler." : {
      "comment" : "Aylık abonelik fiyatı ve yenileme notu",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ شهريًا. يتجدد تلقائيًا في نهاية الفترة ما لم يتم الإلغاء. للإلغاء: الإعدادات > حساب Apple > الاشتراكات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ / Monat. Wird am Ende des Zeitraums automatisch verlängert, sofern nicht gekündigt. Kündigung: Einstellungen > Apple Account > Abonnements."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ / month. Auto-renews at the end of the period unless canceled. To cancel: Settings > Apple Account > Subscriptions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ / mes. Se renueva automáticamente al final del periodo si no lo cancelas. Para cancelar: Ajustes > Cuenta de Apple > Suscripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ / mois. Se renouvelle automatiquement en fin de période sauf annulation. Pour annuler : Réglages > Apple Account > Abonnements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ / mese. Si rinnova automaticamente a fine periodo se non annullato. Per annullare: Impostazioni > Apple Account > Abbonamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ / 月。キャンセルしない限り、期間終了時に自動更新されます。キャンセルは「設定」>「Apple アカウント」>「サブスクリプション」から。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ / 월. 취소하지 않으면 기간이 끝날 때 자동으로 갱신돼요. 취소는 설정 > Apple 계정 > 구독에서 할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ / maand. Wordt aan het einde van de periode automatisch verlengd, tenzij je opzegt. Opzeggen via: Instellingen > Apple Account > Abonnementen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ / mês. Renova automaticamente no fim do período, a menos que seja cancelada. Para cancelar: Ajustes > Apple Account > Assinaturas."
          }
        }
      }
    },
    "%@ / yıl. İptal edilmezse dönem sonunda otomatik yenilenir. İptal için Ayarlar > Apple Hesabı > Abonelikler." : {
