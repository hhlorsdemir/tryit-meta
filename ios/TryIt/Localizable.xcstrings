    "%lld ücretsiz kombinini kullandın. Devam etmek için bir plan seç." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد استخدمت إطلالاتك المجانية البالغة %lld. اختر خطة للمتابعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast deine %lld kostenlosen Outfits aufgebraucht. Wähle einen Plan, um weiterzumachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've used your %lld free outfits. Pick a plan to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya usaste tus %lld looks gratis. Elige un plan para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as utilisé tes %lld looks gratuits. Choisis une formule pour continuer."
          }
        },
        "it" : {
